{
  "1": {
    "class_type": "DLSS5Settings",
    "inputs": {
      "upscaling_mode": "1x (DLAA / native)",
      "nr_preset": "Default",
      "nr_style": "Default",
      "nr_intensity": 1.0,
      "local_tone_strength": 1.0,
      "local_structure_strength": 1.5,
      "skin_structure_strength": 2.0,
      "automatic_mask": true,
      "dlss_model_preset": "M",
      "motion": "auto",
      "scene_change_threshold": 0.24,
      "warmup_frames": 0,
      "runtime_dir": ""
    },
    "_meta": {"title": "DLSS5 Settings"}
  },
  "2": {
    "class_type": "LoadImage",
    "inputs": {"image": "example.png"},
    "_meta": {"title": "Load Image"}
  },
  "3": {
    "class_type": "DLSS5EnhanceImages",
    "inputs": {
      "images": ["2", 0],
      "settings": ["1", 0],
      "verify_neural_rendering": true
    },
    "_meta": {"title": "DLSS5 Enhance Images"}
  },
  "4": {
    "class_type": "SaveImageAdvanced",
    "inputs": {
      "images": ["3", 0],
      "filename_prefix": "dlss5-enhance/image",
      "format": "png",
      "format.bit_depth": "8-bit",
      "format.input_color_space": "sRGB"
    },
    "_meta": {"title": "Save Image (Advanced)"}
  }
}
